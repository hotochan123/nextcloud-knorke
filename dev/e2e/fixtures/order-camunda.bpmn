      <bpmndi:BPMNShape id="Event_start_di" bpmnElement="Event_start" bioc:stroke="#205022" bioc:fill="#c8e6c9" color:background-color="#c8e6c9" color:border-color="#205022">
        <dc:Bounds x="232" y="162" width="36" height="36" />
