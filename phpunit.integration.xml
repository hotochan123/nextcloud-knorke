  -
  - Integration suite (SPEC-M0 §9.2): the real database (any KD_DB kind:
  - PostgreSQL, MariaDB, MySQL, SQLite) and Redis of a dev stack, base.php
  - loaded, guarded by knorke_dev = true. Run with
  - KD_NS=b tests/php/run.sh integration.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd"
         bootstrap="tests/php/bootstrap-integration.php"
         cacheResult="false"
         colors="true"
         failOnWarning="true"
         failOnNotice="true"
         beStrictAboutOutputDuringTests="true">
    <testsuites>
        <testsuite name="integration">
            <directory>tests/php/integration</directory>
        </testsuite>
    </testsuites>
</phpunit>
